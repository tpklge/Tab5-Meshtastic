+void launcherWifiAbortConnect() {
+    expectingConnection = false;
+    autoReconnect = false;
+    if (reconnectTimer) esp_timer_stop(reconnectTimer);
+    if (wifiEvents) xEventGroupClearBits(wifiEvents, WIFI_CONNECTED_BIT | WIFI_FAIL_BIT);
+    esp_wifi_disconnect();
+}
+
+int launcherWifiLastDisconnectReason() { return static_cast<int>(lastDisconnectReason); }
+
 bool launcherWifiConnect(const char *ssid, const char *password, uint32_t timeout_ms) {
